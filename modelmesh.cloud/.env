# GitHub backup variables for scripts/github-backup-pat.sh
# Fill these values, then re-run backup.
# Preferred: keep PAT out of this file and place it in a root-only file.
# Example setup:
#   mkdir -p /root/.config/github-backup
#   printf '%s\n' 'ghp_xxx_replace_me' > /root/.config/github-backup/pat
#   chmod 600 /root/.config/github-backup/pat
GITHUB_PAT_FILE=/root/.config/github-backup/pat
GITHUB_OWNER=OnionSmash
GITHUB_REPO=Web
BACKUP_BRANCH=main-squeez
